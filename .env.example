# ── Upstox ──────────────────────────────────────────────────────────────
# Required for BOTH the live intraday feed and the daily historical snapshot.
# Get it from: Upstox Developer Apps page -> "Analytics" tab -> generate token.
# 1-year validity, read-only. One active per account (regenerating revokes old).
# NEVER commit the real .env; this file only documents the variable names.
UPSTOX_ANALYTICS_TOKEN=

# ── Server ──────────────────────────────────────────────────────────────
# Port the Express service listens on (also serves the built React app in prod).
PORT=8080

# Comma-separated underlyings to exclude from the futures universe (index futures).
# Leave unset to use the built-in default list.
# EXCLUDE_UNDERLYINGS=NIFTY,BANKNIFTY,FINNIFTY,MIDCPNIFTY,NIFTYNXT50

# Expiry policy for which contracts to screen: "all" (default) or "near-next".
# EXPIRY_POLICY=all

# ── Rate limiting ───────────────────────────────────────────────────────
# Upstox DOCUMENTS 50 req/s, but the API sits behind Cloudflare, which enforces
# a much stricter sustained-rate rule and replies `429 / error code: 1015`.
# Once tripped it keeps rejecting for several minutes even after traffic stops.
# Seeding ~420 candle requests at boot trips it at the documented rates, so
# these defaults are deliberately conservative. Raise them only if you have
# verified your account tolerates it.
# UPSTOX_RPS=5
# UPSTOX_RPM=180

# ── Caching ─────────────────────────────────────────────────────────────
# Historical candles are cached on disk under data/cache/candles so restarts
# don't re-fetch immutable data. Set CANDLE_CACHE=0 to disable.
# CANDLE_CACHE=1
# CANDLE_CACHE_TTL_MS=180000

# ── Paper trading ───────────────────────────────────────────────────────
# SQLite file holding paper trades and metrics. Point elsewhere for a scratch
# database; the default accumulates real results, so back it up.
# PAPER_DB_PATH=data/screener.db
