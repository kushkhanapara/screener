{
  "name": "nse-stock-futures-screener",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first NSE single-stock-futures technical screener (live intraday + daily snapshot) via Upstox",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "setup": "node server/scripts/setup.js",
    "dev": "concurrently -n server,client -c blue,magenta \"node --watch server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "live": "node server/scripts/runLive.js",
    "install:all": "npm install && npm --prefix client install",
    "test": "node --test \"server/**/*.test.js\"",
    "test:watch": "node --test --watch \"server/**/*.test.js\"",
    "verify:core": "npm test",
    "report": "node server/scripts/weeklyReport.js",
    "report:shadow": "node server/scripts/shadowReport.js",
    "replay": "node server/scripts/replay.js",
    "download:year": "node server/scripts/replay.js --year --download-only",
    "replay:year": "node --max-old-space-size=6144 server/scripts/replay.js --year --stop-at=08:00",
    "replay:research": "node --max-old-space-size=6144 server/scripts/replay.js --year --research --stop-at=08:00",
    "replay:swing": "node server/scripts/swingReplay.js",
    "verify:universe": "node server/scripts/verifyUniverse.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "technicalindicators": "^3.1.0",
    "upstox-js-sdk": "^2.14.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3"
  }
}
